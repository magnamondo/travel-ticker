{
	"name": "travel-ticker",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-worker.mjs",
		"build:worker": "node scripts/build-worker.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"update": "ncu -u && npm install",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"worker": "npx tsx src/worker/video-worker.ts",
		"worker:video": "npx tsx src/worker/video-worker.ts",
		"worker:notifications": "npx tsx src/worker/notification-worker.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.4.1",
		"@vitest/browser-playwright": "^5.0.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"npm-check-updates": "^23.1.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"resend": "^6.26.0"
	}
}
